#!/usr/bin/python3 -I
"""Start one sandboxed Claude agent for the Claude Plays Glob stream rig.

  sudo -n -u AGENT_USER AGENT_INSTALL_DIR/agent-run player --model M [--resume SESSION_ID]
  sudo -n -u AGENT_USER AGENT_INSTALL_DIR/agent-run chat --model M [--max-budget-usd N]
                                                     [--max-game-calls N | --no-game]

Installed root-owned by install-agent-sandbox.sh and reached only through a narrow sudoers
rule (README "Security and sandboxing"). It must run as the agent user. It clears the environment, sets HOME, PATH, umask 002
and the working directory, reads the Claude token from a root-owned file, and runs the
installed `claude` with fixed flags for the role. Callers can choose only the values above,
so the sudo rule can't start Claude with other tools, MCP servers or settings. The prompt
arrives on stdin.
"""
import ctypes
import json
import os
import pathlib
import pwd
import re
import signal
import socket
import sys

INSTALL = pathlib.Path("@AGENT_INSTALL_DIR@")   # replaced by install-agent-sandbox.sh
ETC = pathlib.Path("@AGENT_ETC_DIR@")             # replaced by install-agent-sandbox.sh
CONF = ETC / "agent.env"
TOKEN = ETC / "claude-oauth-token"
POLICY = INSTALL / "policy"                       # root-owned --settings files, one per role

MODEL_RE = re.compile(r"^(claude-[a-z0-9.-]{1,60}|sonnet|opus|haiku)$")
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
ROLES = {
    "player": {"--model": MODEL_RE, "--resume": UUID_RE},
    "chat": {"--model": MODEL_RE, "--max-budget-usd": re.compile(r"^(?:[0-4](?:\.\d{1,2})?|5(?:\.0{1,2})?)$"),
             "--max-game-calls": re.compile(r"^(?:[0-9]|10)$"), "--no-game": None},
}


def die(msg: str, code: int = 64):
    sys.stderr.write(f"agent-run: {msg}\n")
    sys.exit(code)


def parse(argv: list) -> tuple:
    if not argv or argv[0] not in ROLES:
        die("usage: agent-run player|chat [options]; see the file header")
    role, allowed, opts, i = argv[0], ROLES[argv[0]], {}, 1
    while i < len(argv):
        flag = argv[i]
        if flag not in allowed or flag in opts:
            die(f"option not allowed for {role}: {flag[:40]!r}")
        if allowed[flag] is None:
            opts[flag] = True
            i += 1
            continue
        if i + 1 >= len(argv) or not allowed[flag].match(argv[i + 1]):
            die(f"bad or missing value for {flag}")
        opts[flag] = argv[i + 1]
        i += 2
    if "--model" not in opts:
        die("--model is required")
    return role, opts


def read_conf() -> dict:
    conf = {}
    try:
        text = CONF.read_text()
    except OSError as e:
        die(f"cannot read {CONF} ({e.strerror}); run install-agent-sandbox.sh", 78)
    for line in text.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            conf[k.strip()] = v.strip()
    for key in ("AGENT_USER", "AGENT_SHARED_DIR", "STATE_DIR", "NOTES_DIR", "OVERLAY_FILE", "MCP_PORT",
                "AGENT_EGRESS", "EGRESS_PROXY_PORT"):
        if not conf.get(key):
            die(f"{CONF} lacks {key}; rerun install-agent-sandbox.sh", 78)
    return conf


def can_connect(host: str, port: int, timeout: float = 3.0) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def check_egress(conf: dict) -> dict:
    """Fail closed: with AGENT_EGRESS=1 the firewall must already block direct connections and the
    allowlist proxy must be up. Returns the proxy environment for Claude."""
    if conf["AGENT_EGRESS"] != "1":
        return {}
    if can_connect("1.1.1.1", 443) or can_connect("2606:4700:4700::1111", 443):
        die("direct internet access is not blocked for this user (is glob2-agent-egress.service loaded?); "
            "refusing to start", 79)
    port = int(conf["EGRESS_PROXY_PORT"])
    if not can_connect("127.0.0.1", port):
        die(f"the egress proxy is not listening on 127.0.0.1:{port} (glob2-agent-proxy.service)", 79)
    proxy = f"http://127.0.0.1:{port}"
    return {"HTTPS_PROXY": proxy, "HTTP_PROXY": proxy, "https_proxy": proxy, "http_proxy": proxy,
            "NO_PROXY": "127.0.0.1,localhost", "no_proxy": "127.0.0.1,localhost"}


def main():
    role, opts = parse(sys.argv[1:])
    conf = read_conf()
    me = pwd.getpwuid(os.geteuid())
    if me.pw_name != conf["AGENT_USER"]:
        die(f"must run as {conf['AGENT_USER']} (through sudo -u), not {me.pw_name}", 77)
    try:
        token = TOKEN.read_text().strip()
    except OSError:
        token = ""
    if not token:
        die(f"no Claude token in {TOKEN}: run `claude setup-token`, then "
            f"`sudo install -o root -g {conf['AGENT_USER']} -m 640 /dev/stdin {TOKEN}`", 78)

    proxy_env = check_egress(conf)

    py = ["/usr/bin/python3", "-E", "-s"]           # our MCP servers: no env-driven imports, no user site
    shared_env = {k: conf[k] for k in ("AGENT_SHARED_DIR", "STATE_DIR", "NOTES_DIR", "OVERLAY_FILE", "MCP_PORT")}
    shared_env.update(AGENT_USER=conf["AGENT_USER"], GLOB2_STREAM_HOME=conf["AGENT_SHARED_DIR"])
    game_url = f"http://127.0.0.1:{int(conf['MCP_PORT'])}/mcp"
    claude = str(INSTALL / "bin" / "claude")
    # Flags shared by both roles: no slash commands or skills, nobody to answer a permission
    # prompt (so anything not pre-approved is denied), and the role's root-owned policy file.
    common = ["--disable-slash-commands", "--permission-mode", "dontAsk", "--permission-prompts", "none",
              "--strict-mcp-config", "--output-format", "stream-json", "--verbose"]

    if role == "player":
        servers = {
            # The game, through game_proxy.py: it owns the control lease, so the model never handles a
            # token (a compaction once lost it and locked the player out).
            "glob2-stream": {"command": py[0], "args": py[1:] + [str(INSTALL / "game_proxy.py")],
                             "env": {"MCP_PORT": conf["MCP_PORT"], "STATE_DIR": conf["STATE_DIR"]}},
            "stream-ctl": {"command": py[0], "args": py[1:] + [str(INSTALL / "stream_ctl.py"), "mcp"], "env": shared_env},
        }
        cwd = conf["NOTES_DIR"]
        cmd = [claude, "-p", "--model", opts["--model"], "--restricted", "--tools", "Read,Edit,Write", *common,
               "--settings", str(POLICY / "player.json"),
               "--mcp-config", json.dumps({"mcpServers": servers}),
               "--allowedTools", "mcp__glob2-stream__*", "mcp__stream-ctl__*", "Read(./**)", "Edit(./**)"]
        if "--resume" in opts:
            cmd += ["--resume", opts["--resume"]]
    else:
        cwd = str(pathlib.Path(conf["STATE_DIR"]) / "chat-sandbox")
        no_game = "--no-game" in opts
        cmd = [claude, "-p", "--model", opts["--model"], "--tools", "", "--restricted", *common,
               "--no-session-persistence",
               "--settings", str(POLICY / ("chat-nogame.json" if no_game else "chat.json")),
               "--max-budget-usd", opts.get("--max-budget-usd", "0.50"),
               "--json-schema", (INSTALL / "chat" / "reply_schema.json").read_text(),
               "--system-prompt", (INSTALL / "prompts" / "chat.md").read_text()]
        if no_game:
            cmd += ["--disallowedTools", "mcp__*"]
        else:
            # The proxy can also move the stream camera (chat/camera.py): it reads the player's control
            # token from STATE_DIR/control-token and writes the camera label next to the caption.
            ro_env = {"MCP_PORT": conf["MCP_PORT"], "READONLY_MCP_MAX_CALLS": opts.get("--max-game-calls", "4"),
                      "STATE_DIR": conf["STATE_DIR"], "OVERLAY_FILE": conf["OVERLAY_FILE"]}
            servers = {"glob2-readonly": {"command": py[0], "args": py[1:] + [str(INSTALL / "chat" / "readonly_mcp.py")],
                                          "env": ro_env}}
            cmd += ["--mcp-config", json.dumps({"mcpServers": servers}), "--allowedTools", "mcp__glob2-readonly__*"]

    env = {
        "HOME": me.pw_dir, "USER": me.pw_name, "LOGNAME": me.pw_name, "SHELL": "/bin/sh",
        "PATH": f"{INSTALL / 'bin'}:/usr/bin:/bin", "LANG": "C.UTF-8", "TMPDIR": str(pathlib.Path(me.pw_dir) / "tmp"),
        "CLAUDE_CODE_OAUTH_TOKEN": token,
        # Documented switches (https://code.claude.com/docs/en/env-vars), each a second layer to the
        # policy file and flags: no claude.ai connectors, no updates, telemetry, error reports,
        # feature flags or claude.ai skill/plugin sync (nonessential traffic), no CLAUDE.md or auto
        # memory, no bundled skills, built-in subagents, web fetch, artifacts, workflows, cron or
        # background tasks, and restricted mode even if a flag were dropped.
        "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "DISABLE_AUTOUPDATER": "1", "DISABLE_UPDATES": "1",
        "DISABLE_TELEMETRY": "1", "DISABLE_ERROR_REPORTING": "1", "DISABLE_FEEDBACK_COMMAND": "1",
        "CLAUDE_CODE_DISABLE_FEATURE_FLAGS": "1",
        "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1", "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
        "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1", "CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS": "1",
        "CLAUDE_CODE_DISABLE_WEB_FETCH": "1", "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
        "CLAUDE_CODE_DISABLE_WORKFLOWS": "1", "CLAUDE_CODE_DISABLE_CRON": "1",
        "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1", "CLAUDE_CODE_DISABLE_AGENT_VIEW": "1",
        "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
        "CLAUDE_CODE_RESTRICTED": "1",
        **proxy_env,
    }
    if role == "chat":
        env["CLAUDE_CODE_SKIP_PROMPT_HISTORY"] = "1"
    # Aggressive compaction for the player (user decision 2026-11-24): in a real-time match older
    # context is stale, and lessons live in the notes it rereads. Validated whole numbers only:
    # window >= 100000 tokens (the documented floor), threshold 1-100 percent of it.
    window, pct = conf.get("AGENT_COMPACT_WINDOW", ""), conf.get("AGENT_COMPACT_PCT", "")
    if window.isdigit() and 100000 <= int(window) <= 1000000:
        env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(int(window))
    if pct.isdigit() and 1 <= int(pct) <= 100:
        env["CLAUDE_AUTOCOMPACT_PCT_OVERRIDE"] = str(int(pct))
    pathlib.Path(env["TMPDIR"]).mkdir(mode=0o700, exist_ok=True)
    os.umask(0o002)
    os.chdir(cwd)
    # If sudo is killed outright, take Claude with it rather than leave it playing unattended.
    ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    os.execve(claude, cmd, env)


if __name__ == "__main__":
    main()
