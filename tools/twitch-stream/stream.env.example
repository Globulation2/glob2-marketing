# Globulation 2 stream rig settings. Copy to $GLOB2_STREAM_HOME/stream.env (setup.sh does this).
# $GLOB2_STREAM_HOME (default ~/glob2-stream) is set before this file is read.
# Every value has a default in lib.sh; set only what you want to change.
GLOB2_SRC="$GLOB2_STREAM_HOME/src"                 # glob2 checkout the game runs from
GLOB2_BIN="$GLOB2_SRC/build/linux/client/perf/src/glob2"
GAME_RENDERER="sdl-gpu"                            # Vulkan presents to Xvfb on the real GPU
GAME_USERNAME="Claude"                             # player name in game chat
STREAM_DISPLAY=":99"                               # virtual X display the game draws on
STREAM_SIZE="1920x1080"
STREAM_FPS=60                                      # 60 captures the game's uneven 30-60 fps without judder; Twitch's max
STREAM_VBITRATE="6000k"                            # Twitch: <= 6000k for non-partners (1080p60)
STREAM_ABITRATE="160k"
STREAM_ENCODER=""                                  # empty = auto (h264_nvenc, else libx264)
STREAM_SINK="glob2_stream"                         # PipeWire/Pulse null sink carrying game audio
MCP_PORT=27300                                     # stream game's MCP port (a desktop game keeps 27202)
GAME_PROFILE="$GLOB2_STREAM_HOME/profile"          # separate settings/profile from your own game
TWITCH_INGEST="rtmp://live.twitch.tv/app"          # auto-selected nearest ingest
TWITCH_KEY_FILE="$HOME/.config/glob2-stream/twitch.key"
LOG_DIR="$GLOB2_STREAM_HOME/logs"

# Branding overlay, bottom-right over the map (sizes at 1080p, scaled to STREAM_SIZE).
BRAND=1                                            # 0 disables logo and text
BRAND_LOGO=""                                      # empty = assets/glob2-wordmark.png beside the scripts
BRAND_TEXT="glob2.online"
BRAND_TEXT_SIZE=22
BRAND_WIDTH=200
BRAND_OPACITY=0.85
BRAND_MARGIN_RIGHT=224                             # clears the game's right sidebar and zoom controls
BRAND_MARGIN_BOTTOM=16

# Agents (both default to Sonnet 5.5) and their state.
PLAYER_MODEL="claude-sonnet-5-5"                   # the agent playing the game
CHAT_MODEL="claude-sonnet-5-5"                     # the separate agent answering Twitch chat

# Twitch chat (chat/README.md). Without a bot user and token the chat agent only reads.
TWITCH_CHANNEL="globulation2"
TWITCH_BOT_USER=""
TWITCH_CHAT_TOKEN_FILE="$HOME/.config/glob2-stream/twitch-chat.token"
TWITCH_CLI_ENV="$HOME/.config/twitch-cli/.twitch-cli.env"   # Twitch CLI login used to refresh the chat token

# Agent sandbox (README "Security and sandboxing"). Rerun sandbox/install-agent-sandbox.sh after changing.
AGENT_USER="glob2agent"                            # empty = run the agents as yourself (less isolated)
AGENT_INSTALL_DIR="/opt/glob2-stream-agent"        # root-owned copy of the agent-side code and claude
AGENT_ETC_DIR="/etc/glob2-stream"                  # agent.env and the Claude token
AGENT_SUDOERS="/etc/sudoers.d/glob2-stream"
AGENT_SHARED_DIR="/var/lib/glob2-stream"           # notes/, state/, overlay/ shared by you and the agents
AGENT_EGRESS=1                                     # 1: firewall the agent user to loopback (nftables) and send
                                                   # its API traffic through the allowlist proxy; 0: no network limits
EGRESS_PROXY_PORT=3129                             # sandbox/egress_proxy.py on 127.0.0.1 (glob2-agent-proxy.service)
EGRESS_ALLOW="api.anthropic.com"                   # hosts the proxy tunnels to, port 443 only
# STATE_DIR, NOTES_DIR and OVERLAY_FILE default to state/, notes/ and overlay/caption.txt in AGENT_SHARED_DIR.
