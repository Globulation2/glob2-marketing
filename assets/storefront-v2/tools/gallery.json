{
  "notes": [
    "Maps each device class to its ordered gallery slots, and each store set to a store and a device class.",
    "The gallery itself comes from selection_file when that file exists (written by the capture engineer after the visual review); provisional_gallery below is used only until then. Either way a slot is one line: the capture file (in captures/<device_class>/) and the caption role (shot_overlay_<role> in translations/<locale>.md). Reorder lines to reorder a gallery; change a file name to swap an image.",
    "provisional_gallery was set by the compositor on 2026-11-24 from the first capture round, which the visual review has since mostly rejected: it is layout test material. Its slots are always rendered in the order of asset_text.mobile_gallery_order in translations/platforms.json (hero, build, fair_deal, ...), whatever order the lines below are in; a role that list does not name goes last. The fair-deal slide borrows the second-map capture, which another slot also uses, until it has a frame of its own.",
    "trim removes only the flat system-bar margins a capture carries (status bar, home-indicator band, landscape safe-area bands); the tool refuses a trim that would remove game pixels.",
    "Per image size: card is the card's width as a share of the image width (the capture is scaled to it, never up, and runs off the bottom edge); band is the caption band's share of the image height (everything above the card; verify fails above caption_area_limit); caption_px is the caption's full type size. Every caption of one store set and locale is set at one size, the largest at which all of them fit.",
    "Orientations are fixed (coordinator, 2026-11-24): phones and iPad portrait, Android tablets landscape. A capture in any other pixel size is refused until its size is added to device_classes with a trim and band.",
    "fdroid-phone has no captures of its own: it is the android-phone gallery under another store's rules."
  ],
  "captures_root": "../captures/mobile",
  "selection_file": "../captures/mobile/selection.json",
  "output_root": "../store-screenshots",
  "layout": "framed",
  "caption_area_limit": 0.20,
  "role_variants": {"fair_deal": "gold"},
  "device_classes": {
    "iphone-6.9": {
      "1320x2868": {"trim": {"top": 184, "bottom": 104}, "card": 0.94, "band": 0.17, "caption_px": 148}
    },
    "ipad-13": {
      "2064x2752": {"trim": {"top": 64, "bottom": 40}, "card": 0.94, "band": 0.17, "caption_px": 172}
    },
    "android-phone": {
      "1080x1920": {"card": 0.94, "band": 0.17, "caption_px": 118}
    },
    "android-tablet-7": {
      "1920x1200": {"card": 0.93, "band": 0.16, "caption_px": 112}
    },
    "android-tablet-10": {
      "2560x1600": {"card": 0.93, "band": 0.16, "caption_px": 150}
    }
  },
  "stores": {
    "apple": {"max_bytes": 8000000, "banned": ["universal", "english_claims", "english_price", "mobile", "other_platforms"]},
    "google-play": {"max_bytes": 8000000, "banned": ["universal", "english_claims", "english_price", "mobile", "google_play_english"]},
    "amazon": {"max_bytes": 8000000, "banned": ["universal", "english_claims", "english_price", "mobile", "other_platforms"]},
    "fdroid": {"max_bytes": 8000000, "banned": ["universal", "english_claims", "english_price", "mobile"]}
  },
  "banned": {
    "universal": {"locales": "all", "pattern": "[$€£¥₹₽₩₺₫฿]|#\\s?1\\b", "why": "currency signs and ranking marks (Play metadata policy; App Review 2.3.7)"},
    "english_claims": {"locales": ["en"], "pattern": "\\b(campaigns?|first|forever|never|nothing is sold|hive mind|skins?|credits?|studios?|best|#1|top-rated|award|download now|play now)\\b", "why": "mirrors test_no_banned_claims_anywhere in translations/tests/test_storefront.py"},
    "english_price": {"locales": ["en"], "pattern": "\\b(free|price|sale|discount|paid|buy)\\b", "why": "mirrors test_image_and_trailer_text_is_short_and_carries_no_price_words"},
    "mobile": {"locales": "all", "case_sensitive": true, "pattern": "MCP|AI agent|JavaScript", "why": "mobile listings never mention agents or MCP (test_mobile_listings_never_mention_agents_or_mcp)"},
    "google_play_english": {"locales": ["en"], "pattern": "\\b(best|top|new|free|discount|sale|install now|download now|play now|try now)\\b", "why": "words Google Play asks screenshots and graphics to avoid (analysis/mobile-store-comparables.md)"},
    "other_platforms": {"locales": "all", "pattern": "android|google\\s?play|play store|windows|microsoft|steam|epic games|f-droid|linux|kindle", "why": "App Review 2.3.10: no other platforms or marketplaces; kept for Amazon too"}
  },
  "store_sets": {
    "apple-iphone-6.9": {"store": "apple", "device_class": "iphone-6.9"},
    "apple-ipad-13": {"store": "apple", "device_class": "ipad-13"},
    "google-play-phone": {"store": "google-play", "device_class": "android-phone"},
    "google-play-tablet-7": {"store": "google-play", "device_class": "android-tablet-7"},
    "google-play-tablet-10": {"store": "google-play", "device_class": "android-tablet-10"},
    "amazon-tablet": {"store": "amazon", "device_class": "android-tablet-10"},
    "fdroid-phone": {"store": "fdroid", "device_class": "android-phone"}
  },
