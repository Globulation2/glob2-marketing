diff --git a/src/common/CaptureClock.h b/src/common/CaptureClock.h
new file mode 100644
index 0000000000..ed7343f365
--- /dev/null
+++ b/src/common/CaptureClock.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <SDL3/SDL_timer.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+
+//! Frame-by-frame store capture (local capture builds only: GLOB2_CAPTURE_MCP,
+//! never shipped). While the capture clock runs, the match view draws only the
+//! frames a device at a fixed frame rate would draw for the ticks the match
+//! actually ran (framesPerTick frames for every new tick, plus frames granted
+//! explicitly), and the presentation clocks (water and cloud animation, the
+//! event list's lifetimes, the tick-rate readout, unit-motion and fog-fade
+//! fractions) read a virtual time that advances by exactly one frame interval
+//! per drawn frame. Between frames nothing is drawn, so a slow screenshot of the
+//! held match shows exactly the frame the device would have shown, at real
+//! game speed, however long the capture takes. The simulation itself is never
+//! touched: its ticks are stepped with game_time as usual.
+namespace CaptureClock
+{
+#if defined(GLOB2_CAPTURE_MCP)
+inline std::atomic<bool> enabled{false};
+inline std::atomic<std::uint64_t> baseNs{0};
+inline std::atomic<std::uint64_t> virtualNs{0};
+inline std::atomic<std::uint64_t> drawnFrames{0};
+inline std::atomic<int> pendingFrames{0};
+inline std::atomic<int> framesPerTick{2};
+inline std::atomic<std::uint64_t> lastTick{~std::uint64_t(0)};
+inline std::atomic<std::uint64_t> lastDrawnTick{~std::uint64_t(0)};
+//! Ticks a second at the normal game speed (1x).
+inline constexpr std::uint64_t TICKS_PER_SECOND = 30;
+
+inline bool active() { return enabled.load(); }
+inline std::uint64_t nowNs() { return active() ? virtualNs.load() : SDL_GetTicksNS(); }
+inline std::uint64_t nowMs() { return nowNs() / 1'000'000ULL; }
+
+inline void start(int frames)
+{
+	framesPerTick = frames > 0 ? frames : 2;
+	baseNs = SDL_GetTicksNS();
+	virtualNs = baseNs.load();
+	drawnFrames = 0;
+	pendingFrames = 0;
+	lastTick = ~std::uint64_t(0);
+	enabled = true;
+}
+inline void stop() { enabled = false; }
+inline void grant(int frames) { pendingFrames += frames; }
+
+//! The draw gate, asked once per host frame with the tick of the scene about to
+//! be drawn: true when this frame draws (and the virtual time has advanced by
+//! one frame interval), false when the host frame must draw nothing.
+inline bool admit(std::uint64_t tick)
+{
+	if (!active())
+		return true;
+	// framesPerTick frames for every tick run since the last drawn scene (a step of
+	// several ticks draws its newest scene that many times), so the presentation
+	// time always advances by exactly one tick interval per tick.
+	const std::uint64_t previous = lastTick.exchange(tick);
+	if (previous != tick)
+	{
+		const std::uint64_t ran = previous == ~std::uint64_t(0) || tick < previous ? 1 : std::min<std::uint64_t>(tick - previous, 3000);
+		pendingFrames += int(ran) * framesPerTick.load();
+	}
+	if (pendingFrames.load() <= 0)
+		return false;
+	--pendingFrames;
+	const std::uint64_t frame = ++drawnFrames;
+	virtualNs = baseNs.load() + frame * 1'000'000'000ULL / (TICKS_PER_SECOND * std::uint64_t(framesPerTick.load()));
+	lastDrawnTick = tick;
+	return true;
+}
+#else
+inline constexpr bool active() { return false; }
+inline std::uint64_t nowNs() { return SDL_GetTicksNS(); }
+inline std::uint64_t nowMs() { return SDL_GetTicks(); }
+inline constexpr bool admit(std::uint64_t) { return true; }
+#endif
+} // namespace CaptureClock
